[Unit]
Description=Update Cloudflare IP ranges for nginx real IP and origin access
Documentation=https://developers.cloudflare.com/support/troubleshooting/restoring-visitor-ips/restoring-original-visitor-ips/
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/update-cloudflare-nginx
