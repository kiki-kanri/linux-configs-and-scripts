" Startup and runtime support.
set nocompatible
runtime! debian.vim

" System settings must not be overwritten by a later defaults.vim load.
let g:skip_defaults_vim = 1
let mapleader = ' '

syntax enable
filetype plugin indent on

" Resolve relative to this vimrc, both in the repository and under /etc/vim.
let s:config_dir = expand('<sfile>:p:h') . '/vimrc.d'
for s:module in ['options', 'indentation', 'workflow']
    execute 'source ' . fnameescape(s:config_dir . '/' . s:module . '.vim')
endfor
unlet s:config_dir s:module
